# systemd unit for running Rusted on a Linux server.
# Copy to /etc/systemd/system/rusted.service, then:
#   sudo systemctl enable --now rusted
[Unit]
Description=Rusted Bedrock server
After=network-online.target
Wants=network-online.target

[Service]
User=rusted
WorkingDirectory=/opt/rusted
ExecStart=/opt/rusted/rusted
Restart=on-failure
RestartSec=5
# Ctrl+C equivalent, so the world and players get saved
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
